# Cross-compile native ELF on Windows without WSL or a machine reboot.
set(CMAKE_SYSTEM_NAME Linux)
set(CMAKE_SYSTEM_PROCESSOR x86_64)
get_filename_component(SONIC_CROSS_ROOT "${CMAKE_CURRENT_LIST_DIR}/../.." ABSOLUTE)
set(SONIC_ZIG "${SONIC_CROSS_ROOT}/.local/linux-deps/zig/zig-x86_64-windows-0.16.0/zig.exe")
if(NOT EXISTS "${SONIC_ZIG}")
    message(FATAL_ERROR "Prepare the pinned Linux cross-toolchain first")
endif()
set(CMAKE_C_COMPILER "${SONIC_ZIG}")
set(CMAKE_C_COMPILER_ARG1 "cc -target x86_64-linux-gnu.2.31")
set(CMAKE_CXX_COMPILER "${SONIC_ZIG}")
set(CMAKE_CXX_COMPILER_ARG1 "c++ -target x86_64-linux-gnu.2.31")
set(CMAKE_AR "${SONIC_ZIG}")
set(CMAKE_RANLIB "${SONIC_ZIG}")
set(CMAKE_C_ARCHIVE_CREATE "<CMAKE_AR> ar qc <TARGET> <LINK_FLAGS> <OBJECTS>")
set(CMAKE_C_ARCHIVE_APPEND "<CMAKE_AR> ar q <TARGET> <LINK_FLAGS> <OBJECTS>")
set(CMAKE_C_ARCHIVE_FINISH "<CMAKE_RANLIB> ranlib <TARGET>")
set(CMAKE_CXX_ARCHIVE_CREATE "${CMAKE_C_ARCHIVE_CREATE}")
set(CMAKE_CXX_ARCHIVE_APPEND "${CMAKE_C_ARCHIVE_APPEND}")
set(CMAKE_CXX_ARCHIVE_FINISH "${CMAKE_C_ARCHIVE_FINISH}")
set(CMAKE_FIND_ROOT_PATH "${SONIC_CROSS_ROOT}/.local/linux-sysroot")
set(CMAKE_FIND_ROOT_PATH_MODE_PROGRAM NEVER)
set(CMAKE_FIND_ROOT_PATH_MODE_LIBRARY ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_INCLUDE ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_PACKAGE ONLY)
# Link capability probes as ELF executables, but never execute them on Windows.
set(CMAKE_TRY_COMPILE_TARGET_TYPE EXECUTABLE)
